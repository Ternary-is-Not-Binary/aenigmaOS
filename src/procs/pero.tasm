pe_mrg:
        LI   R2, pe_mark
        LDW  R3, [R2]
        LI   R2, pe_cur
        LDW  R4, [R2]
        TCMP R2, R3, R4
        B3   R2, pe_mrg_a, pe_mrg_e, pe_mrg_b
pe_mrg_a:
        LI   R2, pe_t1
        STW  [R2], R3
        LI   R2, pe_t2
        STW  [R2], R4
        B    pe_mrg_ok
pe_mrg_b:
        LI   R2, pe_t1
        STW  [R2], R4
        LI   R2, pe_t2
        STW  [R2], R3
pe_mrg_ok:
        LI   R1, 1
        RET
pe_mrg_e:
        LI   R1, 0
        RET

pe_cutsel:
        LI   R2, pe_cp8
        STW  [R2], R8
        CALL pe_mrg
        B3   R1, pe_ctr0, pe_ctr0, pe_ctr1
pe_ctr0:
        LI   R3, -1
        LI   R2, pe_mark
        STW  [R2], R3
        LI   R1, 0
        B    pe_ctrx
pe_ctr1:
        CALL pe_fcl
        CALL pe_rdel
pe_ctrx:
        LI   R2, pe_cp8
        LDW  R8, [R2]
        RET

pe_copyr:
        LI   R2, pe_cp8
        STW  [R2], R8
        CALL pe_mrg
        B3   R1, pe_cpr0, pe_cpr0, pe_cpr1
pe_cpr1:
        CALL pe_fcl
pe_cpr0:
        LI   R3, -1
        LI   R2, pe_mark
        STW  [R2], R3
        LI   R2, pe_cp8
        LDW  R8, [R2]
        RET

pe_delr:
        LI   R2, pe_cp8
        STW  [R2], R8
        CALL pe_mrg
        B3   R1, pe_dlr0, pe_dlr0, pe_dlr1
pe_dlr0:
        LI   R3, -1
        LI   R2, pe_mark
        STW  [R2], R3
        LI   R1, 0
        B    pe_dlrx
pe_dlr1:
        CALL pe_rdel
pe_dlrx:
        LI   R2, pe_cp8
        LDW  R8, [R2]
        RET

pe_rdel:
        LI   R2, pe_rd8
        STW  [R2], R8
        CALL pe_snap
        LI   R2, pe_t1
        LDW  R3, [R2]
        LI   R2, pe_t2
        LDW  R6, [R2]
        NEG  R5, R3
        ADD  R6, R6, R5
        LI   R2, pe_len
        LDW  R4, [R2]
        NEG  R7, R6
        ADD  R7, R7, R4
pe_rdmv:
        TCMP R2, R3, R7
        B3   R2, pe_rdmm, pe_rdmd, pe_rdmd
pe_rdmm:
        ADD  R1, R3, R6
        LI   R2, pe_buf
        ADD  R5, R2, R3
        ADD  R2, R2, R1
        LDT  R1, [R2]
        STT  [R5], R1
        LI   R2, 1
        ADD  R3, R3, R2
        B    pe_rdmv
pe_rdmd:
        LI   R2, pe_len
        STW  [R2], R7
        LI   R2, pe_t1
        LDW  R3, [R2]
        LI   R2, pe_cur
        STW  [R2], R3
        LI   R3, -1
        LI   R2, pe_mark
        STW  [R2], R3
        LI   R1, 1
        LI   R2, pe_rd8
        LDW  R8, [R2]
        RET

