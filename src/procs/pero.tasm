        B3   R2, pe_stn3, pe_stf, pe_stn3
pe_stf:
        LI   R1, pe_s4
        CALL pe_estr
        B    pe_strm
pe_stn3:
        LI   R4, 3
        TCMP R2, R3, R4
        B3   R2, pe_stb0, pe_stb, pe_stb0
pe_stb:
        LI   R1, pe_s5
        CALL pe_estr
pe_strm:
        LI   R2, pe_note
        STW  [R2], R0
        B    pe_sth2
pe_stb0:
        LI   R1, pe_s2
        CALL pe_estr
pe_sth2:
        LI   R1, 27
        CALL pe_ech
        LI   R1, 91
        CALL pe_ech
        LI   R1, 48
        CALL pe_ech
        LI   R1, 109
        CALL pe_ech
pe_stk:
        LI   R1, 27
        CALL pe_ech
        LI   R1, 91
        CALL pe_ech
        LI   R1, 75
        CALL pe_ech
        LI   R2, pe_rb
        LDW  R8, [R2]
        RET

pe_draw:
        LI   R2, pe_ra
        STW  [R2], R8
        LI   R3, -1
        LI   R2, pe_slo
        STW  [R2], R3
        LI   R2, pe_shi
        STW  [R2], R3
        LI   R2, pe_mark
        LDW  R6, [R2]
        B3   R6, pe_dframe, pe_dmk, pe_dmk
pe_dmk:
        LI   R2, pe_cur
        LDW  R7, [R2]
        TCMP R2, R6, R7
        B3   R2, pe_dlo, pe_dframe, pe_dhi
pe_dlo:
        LI   R2, pe_slo
        STW  [R2], R6
        LI   R2, pe_shi
        STW  [R2], R7
        B    pe_dframe
pe_dhi:
        LI   R2, pe_slo
        STW  [R2], R7
        LI   R2, pe_shi
        STW  [R2], R6
pe_dframe:
        LI   R3, pe_fp
        LI   R4, pe_fr
        STW  [R3], R4
        LI   R1, 27
        CALL pe_ech
        LI   R1, 91
        CALL pe_ech
        LI   R1, 72
        CALL pe_ech
        LI   R2, pe_cur
        LDW  R5, [R2]
        MOV  R6, R5
pe_dwl:
        B3   R6, pe_dwz, pe_dwz, pe_dws
pe_dwz:
        LI   R6, 0
        B    pe_dww
pe_dws:
        LI   R3, pe_buf
        ADD  R3, R3, R6
        LDT  R1, [R3-1]
        LI   R2, 10
        TCMP R2, R1, R2
        B3   R2, pe_dwd, pe_dww, pe_dwd
pe_dwd:
        LI   R2, -1
        ADD  R6, R6, R2
        B    pe_dwl
pe_dww:
        NEG  R3, R6
        ADD  R3, R3, R5
        LI   R2, pe_cc
        STW  [R2], R3
        LI   R2, pe_top
        LDW  R6, [R2]
        LI   R7, 0
pe_drl2:
        TCMP R2, R6, R5
        B3   R2, pe_drc2, pe_drd2, pe_drd2
pe_drd2:
        B    pe_drw
pe_drc2:
        LI   R3, pe_buf
        ADD  R3, R3, R6
        LDT  R1, [R3]
        LI   R2, 10
        TCMP R2, R1, R2
        B3   R2, pe_drn, pe_dry, pe_drn
pe_dry:
        LI   R2, 1
        ADD  R7, R7, R2
pe_drn:
        LI   R2, 1
        ADD  R6, R6, R2
        B    pe_drl2
pe_drw:
        LI   R2, pe_cr
        STW  [R2], R7
        LI   R2, pe_top
        LDW  R6, [R2]
        LI   R5, 0
        LI   R7, 0
pe_dal:
        TCMP R2, R5, R6
        B3   R2, pe_dab, pe_dad, pe_dad
pe_dab:
        LI   R3, pe_buf
        ADD  R3, R3, R5
        LDT  R1, [R3]
        LI   R2, 10
        TCMP R2, R1, R2
        B3   R2, pe_dan, pe_day, pe_dan
pe_day:
        LI   R2, 1
        ADD  R7, R7, R2
pe_dan:
        LI   R2, 1
        ADD  R5, R5, R2
        B    pe_dal
pe_dad:
        LI   R2, pe_cr
        LDW  R3, [R2]
        ADD  R7, R7, R3
        LI   R2, 1
        ADD  R7, R7, R2
        LI   R2, pe_rnum
        STW  [R2], R7
        LI   R2, pe_cc
        LDW  R3, [R2]
        LI   R2, 1
        ADD  R3, R3, R2
        LI   R2, pe_cnum
        STW  [R2], R3
        LI   R2, pe_off
        LDW  R6, [R2]
        LI   R2, pe_cc
        LDW  R3, [R2]
        TCMP R2, R3, R6
        B3   R2, pe_dol, pe_dok, pe_dog
pe_dol:
        LI   R2, pe_off
        STW  [R2], R3
        B    pe_dok
pe_dog:
        LI   R2, -63
        ADD  R2, R3, R2
        TCMP R4, R6, R2
        B3   R4, pe_doa, pe_dok, pe_dok
pe_doa:
        LI   R2, -63
        ADD  R2, R3, R2
        LI   R4, pe_off
        STW  [R4], R2
pe_dok:
        LI   R2, pe_r
        STW  [R2], R0
        LI   R2, pe_top
        LDW  R3, [R2]
        LI   R2, pe_s
        STW  [R2], R3
pe_drl3:
        CALL pe_row
        LI   R2, pe_r
        LDW  R3, [R2]
        LI   R4, 1
        ADD  R3, R3, R4
        STW  [R2], R3
        LI   R4, -19
        ADD  R4, R3, R4
        B3   R4, pe_drl3, pe_drs, pe_drs
pe_drs:
        CALL pe_stat
        LI   R1, 27
        CALL pe_ech
        LI   R1, 91
        CALL pe_ech
        LI   R2, pe_cr
        LDW  R1, [R2]
        LI   R3, 1
        ADD  R1, R1, R3
        CALL pe_dig
        LI   R1, 59
        CALL pe_ech
        LI   R2, pe_cc
        LDW  R1, [R2]
        LI   R2, pe_off
        LDW  R3, [R2]
        NEG  R3, R3
        ADD  R1, R1, R3
        LI   R3, 1
        ADD  R1, R1, R3
        CALL pe_dig
        LI   R1, 72
        CALL pe_ech
        CALL pe_flush
        LI   R2, pe_ra
        LDW  R8, [R2]
        RET

pe_save:
        LI   R2, pe_len
        LDW  R4, [R2]
        LI   R3, 10
        ADD  R4, R4, R3
        LI   R2, pe_id
        LDW  R5, [R2]
        B3   R5, pe_svn, pe_sva, pe_tvo
pe_tvo: B    pe_svo
pe_svn:
        B    pe_sva
pe_svo:
        MOV  R1, R5
        SYS  21
        B3   R1, pe_svf, pe_svf, pe_svg
pe_svf:
        LI   R2, pe_id
        STW  [R2], R0
        B    pe_sva
pe_svg:
        LI   R2, pe_ann
        LDW  R3, [R2]
        TCMP R2, R4, R3
        B3   R2, pe_svi, pe_svi, pe_sva
pe_svi:
        LI   R3, 9
        ADD  R1, R1, R3
        LI   R2, pe_t1
        STW  [R2], R1
        LI   R6, 0
pe_svcl:
        LI   R2, pe_len
        LDW  R3, [R2]
        TCMP R2, R6, R3
        B3   R2, pe_svcg, pe_svcn, pe_svcn
pe_svcn:
        B    pe_svcw
pe_svcg:
        LI   R3, pe_buf
        ADD  R3, R3, R6
        LDT  R1, [R3]
        LI   R2, pe_t1
        LDW  R5, [R2]
        ADD  R5, R5, R6
        STT  [R5], R1
        LI   R3, 1
        ADD  R6, R6, R3
        B    pe_svcl
pe_svcw:
        LI   R2, pe_t1
        LDW  R5, [R2]
        ADD  R5, R5, R6
        STT  [R5], R0
        B    pe_svd
pe_sva:
        LI   R1, 6
        MOV  R2, R4
        SYS  20
        B3   R1, pe_svm, pe_svm, pe_svg2
pe_svm:
        B    pe_svf2
pe_svf2:
        LI   R2, 2
        LI   R3, pe_note
        STW  [R3], R2
        RET
pe_svg2:
        MOV  R6, R1
        SYS  21
        LI   R2, pe_t1
        STW  [R2], R1
        LI   R2, pe_t2
        STW  [R2], R6
        LI   R2, pe_id
        LDW  R1, [R2]
        B3   R1, pe_svn0, pe_svn0, pe_svnco
pe_svn0:
        LI   R7, 0
pe_svzl:
        LI   R2, 9
        TCMP R2, R7, R2
        B3   R2, pe_svzz, pe_svzd, pe_svzd
pe_svzz:
        LI   R2, pe_t1
        LDW  R5, [R2]
        ADD  R5, R5, R7
        STT  [R5], R0
        LI   R2, 1
        ADD  R7, R7, R2
        B    pe_svzl
pe_svzd:
        B    pe_svp9
pe_svnco:
        SYS  21
        LI   R7, 0
pe_svcl2:
        LI   R2, 9
        TCMP R2, R7, R2
        B3   R2, pe_svz2, pe_svzd2, pe_svzd2
pe_svz2:
        ADD  R3, R1, R7
        LDT  R4, [R3]
        LI   R2, pe_t1
        LDW  R5, [R2]
        ADD  R5, R5, R7
        STT  [R5], R4
        LI   R2, 1
        ADD  R7, R7, R2
        B    pe_svcl2
pe_svzd2:
pe_svp9:
        LI   R2, pe_t1
        LDW  R5, [R2]
        LI   R3, 9
        ADD  R5, R5, R3
        STW  [R2], R5
        LI   R6, 0
pe_svnl:
        LI   R2, pe_len
        LDW  R3, [R2]
        TCMP R2, R6, R3
        B3   R2, pe_svng, pe_svnn, pe_svnn
pe_svnn:
        B    pe_svnw
pe_svng:
        LI   R3, pe_buf
        ADD  R3, R3, R6
        LDT  R1, [R3]
        LI   R2, pe_t1
        LDW  R5, [R2]
        ADD  R5, R5, R6
        STT  [R5], R1
        LI   R3, 1
        ADD  R6, R6, R3
        B    pe_svnl
pe_svnw:
        LI   R2, pe_t1
        LDW  R5, [R2]
        ADD  R5, R5, R6
        STT  [R5], R0
        LI   R2, pe_id
        LDW  R1, [R2]
        B3   R1, pe_svk, pe_svk, pe_svdel
pe_svk:
        B    pe_svnu
pe_svdel:
        SYS  22
pe_svnu:
        LI   R2, pe_t2
        LDW  R3, [R2]
        LI   R2, pe_id
        STW  [R2], R3
        LI   R2, pe_len
        LDW  R3, [R2]
        LI   R2, 10
        ADD  R3, R3, R2
        LI   R2, pe_ann
        STW  [R2], R3
pe_svd:
        LI   R2, pe_dir
        STW  [R2], R0
        LI   R2, 1
        LI   R3, pe_note
        STW  [R3], R2
        RET

pe_kmrk:
        LI   R2, pe_mark
        LDW  R3, [R2]
        LI   R4, pe_cur
        LDW  R5, [R4]
        B3   R3, pe_kms, pe_kmc, pe_kmc
pe_kms:
        STW  [R2], R5
        B    pe_red
pe_kmc:
        LI   R5, -1
        STW  [R2], R5
        B    pe_red

pe_eon:
        LI   R2, pe_t8
        STW  [R2], R8
        LI   R1, 27
        CALL pe_ech
        LI   R1, 91
        CALL pe_ech
        LI   R1, 55
        CALL pe_ech
