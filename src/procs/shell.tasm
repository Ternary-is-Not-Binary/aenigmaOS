upa_have:
        LI   R2, 1
        ADD  R3, R3, R2
        LI   R4, st_ptr
        STW  [R4], R3
        LI   R2, st_w
        LDW  R2, [R2]
        LI   R3, 3
        MUL  R2, R2, R3
        ADD  R2, R2, R1
        LI   R4, st_w
        STW  [R4], R2
        LI   R2, st_wl
        LDW  R2, [R2]
        MUL  R2, R2, R3
        ADD  R2, R2, R1
        LI   R4, st_wl
        STW  [R4], R2
        B    upa_loop
upa_dn:
        LI   R1, st_pmode
        LDW  R1, [R1]
        LI   R2, 1
        TCMP R2, R1, R2
        B3   R2, t_upac, t_upaw, t_upac
t_upaw: B    u_pw
t_upac: B    u_pck
u_pw:
        LI   R1, st_w
        LDW  R1, [R1]
        LI   R3, st_cur
        LDW  R3, [R3]
        STW  [R3], R1
        LI   R2, 3
        ADD  R3, R3, R2
        LI   R4, st_cur
        STW  [R4], R3
        LI   R1, st_k
        LDW  R1, [R1]
        LI   R2, 1
        ADD  R1, R1, R2
        LI   R4, st_k
        STW  [R4], R1
        LI   R3, st_wl
        LDW  R3, [R3]
        LI   R1, st_ck
        LDW  R1, [R1]
        ADD  R3, R3, R1
        LI   R2, 364
        TCMP R2, R3, R2
        B3   R2, u_pwlo, u_pwlo, t_pwhi
t_pwhi: LI   R2, 729
        NEG  R2, R2
        ADD  R3, R3, R2
u_pwlo: LI   R2, -364
        TCMP R2, R3, R2
        B3   R2, t_pwad, t_pws, t_pws
t_pwad: LI   R2, 729
        ADD  R3, R3, R2
t_pws:  LI   R4, st_ck
        STW  [R4], R3
        LI   R1, 46
        SYS  0
