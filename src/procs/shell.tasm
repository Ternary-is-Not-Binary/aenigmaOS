        LI   R2, 9
        ADD  R2, R2, R3
        LI   R1, 5
        SYS  20
        B3   R1, t_arf2, t_arf2, sha_new
t_arf2: B    sha_roomf
sha_new:
        MOV  R6, R1
        SYS  21
        MOV  R4, R1
        LI   R5, 0
        STW  [R4], R5
        LI   R2, 3
        ADD  R4, R4, R2
        STW  [R4], R5
        ADD  R4, R4, R2
        STW  [R4], R5
        LI   R2, -6
        ADD  R4, R4, R2
        LI   R2, st_nm
        LI   R5, 0
        LI   R1, st_i
        STW  [R1], R0
sha_nl: LDT  R1, [R2]
        STT  [R4], R1
        B3   R1, sha_nnz, sha_np, sha_nnz
sha_np: LI   R2, st_i
sha_nnz:
        LI   R1, 1
        ADD  R2, R2, R1
        ADD  R4, R4, R1
        ADD  R5, R5, R1
        LI   R1, 9
        TCMP R3, R5, R1
        B3   R3, t_anl, sha_nd, sha_nd
t_anl:  B    sha_nl
sha_nd:
        MOV  R1, R6
        SYS  21
        LI   R2, 9
        ADD  R1, R1, R2
        LI   R2, st_c2
        STW  [R2], R1
        LI   R2, st_md
        LI   R1, 2
        STW  [R2], R1
        LI   R2, st_zk
        STW  [R2], R0
        LI   R2, st_zl
        LDW  R1, [R2]
        LI   R2, st_zc
        STW  [R2], R1
        CALL za_parse
        LI   R1, msg_aok
        SYS  10
        LI   R2, st_zk
        LDW  R1, [R2]
        SYS  1
        LI   R1, msg_awid
        SYS  10
        MOV  R1, R6
        SYS  1
        LI   R1, msg_snl
        SYS  10
        LI   R2, st_tid
        LDW  R1, [R2]
        SYS  22
        B    sh_loop
sha_emp:
        LI   R1, msg_aemp
        SYS  10
        LI   R2, st_o2
        LDW  R1, [R2]
        SYS  10
sha_x1: LI   R2, st_tid
        LDW  R1, [R2]
        SYS  22
        B    sh_loop
sha_bcap:
        LI   R1, msg_rcap
        SYS  10
