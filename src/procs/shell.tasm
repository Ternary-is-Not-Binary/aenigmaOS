shu_d:  LDT  R5, [R3]
        LI   R6, 48
        NEG  R2, R6
        ADD  R2, R2, R5
        B3   R2, shu_use, shu_r, shu_r
shu_r:  LI   R6, 10
        TCMP R4, R2, R6
        B3   R4, shu_go, shu_use, shu_use
shu_go: MUL  R1, R1, R6
        ADD  R1, R1, R2
        LI   R6, 1
        ADD  R3, R3, R6
        B    shu_d
shu_use:
        B3   R1, shu_no, shu_no, shu_ok
