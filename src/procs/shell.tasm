t_urd:  B    u_rdc
t_unx:  B    u_e_eof
u_rg:   LI   R2, 13
        TCMP R2, R1, R2
        B3   R2, u_r10, t_rskip, u_r10
t_rskip: B   u_rdc
u_r10:  LI   R2, 10
        TCMP R2, R1, R2
        B3   R2, u_rstore, t_reol, u_rstore
t_reol: B    u_reol
u_rstore:
        STT  [R3], R1
        LI   R2, 1
