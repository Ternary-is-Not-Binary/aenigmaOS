za_parse:
        LI   R2, st_o2
        LDW  R1, [R2]
        LI   R2, st_oc
        STW  [R2], R1
za_pl:  LI   R2, st_oc
        LDW  R3, [R2]
        LDT  R1, [R3]
        B3   R1, za_ret, za_ret, za_c
za_ret: RET
za_c:   LI   R2, 10
        TCMP R4, R1, R2
