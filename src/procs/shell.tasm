za_adv: LI   R2, 1
        ADD  R3, R3, R2
        LI   R2, st_oc
        STW  [R2], R3
        B    za_pl
t_znn:  B    za_nn
za_nn:  LI   R2, 35
        TCMP R4, R1, R2
        B3   R4, t_zw, za_cmt, t_zw
za_cmt: LDT  R1, [R3]
        B3   R1, za_ret, za_ret, za_ck
za_ck:  LI   R2, 10
        TCMP R4, R1, R2
        B3   R4, za_cs, t_zad, za_cs
za_cs:  LI   R2, 1
        ADD  R3, R3, R2
        B    za_cmt
t_zad:  B    za_adv
t_zw:   B    za_w
za_w:   LI   R4, 18
        LI   R5, 0
za_wl:  LDT  R1, [R3]
        LI   R2, 43
        TCMP R2, R1, R2
        B3   R2, t_zbad, za_wp, t_zwm
za_wp:  LI   R1, 1
        B    za_wacc
t_zwm:  B    za_wm
za_wm:  LI   R2, 45
        TCMP R2, R1, R2
        B3   R2, za_wz, za_wmn, za_wz
za_wmn: LI   R1, -1
        B    za_wacc
za_wz:  LI   R2, 48
        TCMP R2, R1, R2
        B3   R2, t_zbad, za_wo2, t_zbad
za_wo2: LI   R1, 0
za_wacc:
        LI   R2, 3
        MUL  R5, R5, R2
        ADD  R5, R5, R1
        LI   R2, 1
        ADD  R3, R3, R2
        LI   R2, -1
        ADD  R4, R4, R2
        B3   R4, t_zwd, t_zwd, t_zwl
t_zwd:  B    za_wd
t_zwl:  B    za_wl
t_zbad: B    za_bad
za_wd:  LI   R2, st_oc
        STW  [R2], R3
        LI   R2, st_md
        LDW  R1, [R2]
        LI   R2, 1
        TCMP R2, R1, R2
        B3   R2, za_wr, za_zl, za_wr
za_wr:  LI   R2, st_zc
        LDW  R1, [R2]
        B3   R1, za_ww, za_ww, za_zsk
za_zsk: LI   R2, -1
        ADD  R1, R1, R2
        LI   R2, st_zc
        STW  [R2], R1
        B    za_pl
za_ww:  LI   R2, st_c2
        LDW  R1, [R2]
        STW  [R1], R5
        LI   R2, 3
        ADD  R1, R1, R2
        LI   R2, st_c2
        STW  [R2], R1
        B    za_k
za_zl:  LI   R2, st_zl
        LDW  R1, [R2]
        LI   R2, st_zk
        LDW  R2, [R2]
        TCMP R4, R1, R2
        B3   R4, za_k, t_zzc, za_k
t_zzc:  B    za_zc
za_zc:  B3   R5, za_k, za_zi, za_k
za_zi:  LI   R2, st_zl
        LDW  R1, [R2]
        LI   R2, 1
        ADD  R1, R1, R2
        LI   R2, st_zl
        STW  [R2], R1
za_k:   LI   R2, st_zk
        LDW  R1, [R2]
        LI   R2, 1
        ADD  R1, R1, R2
        LI   R2, st_zk
        STW  [R2], R1
        LI   R2, 41001
        TCMP R2, R1, R2
        B3   R2, t_zpl, za_ov, za_ov
t_zpl:  B    za_pl
za_ov:  LI   R1, msg_aovf
        SYS  10
        B    sh_loop
za_bad: LI   R1, msg_abad
        SYS  10
        LI   R2, st_o2
        LDW  R1, [R2]
        SYS  10
        B    sh_loop

sh_u:
        LI   R3, shbuf
        LI   R6, 1
        ADD  R3, R3, R6
        LI   R1, 0
shu_sp: LDT  R5, [R3]
        LI   R6, 32
        TCMP R2, R5, R6
        B3   R2, shu_d, shu_adv, shu_d
shu_adv:
        LI   R6, 1
        ADD  R3, R3, R6
