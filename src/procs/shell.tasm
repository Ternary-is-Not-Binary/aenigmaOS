upa_loop:
        LI   R3, st_ptr
        LDW  R3, [R3]
        LDT  R1, [R3]
        B3   R1, t_upadn, t_upadn, upa_go
t_upadn: B   upa_dn
upa_go:
        LI   R2, shb12
        TCMP R2, R3, R2
        B3   R2, upa_nwl, t_upaz, upa_nwl
t_upaz: LI   R4, st_wl
        STW  [R4], R0
upa_nwl:
        LI   R2, 48
        TCMP R2, R1, R2
        B3   R2, upa_m1, t_paz, upa_m1
t_paz:  LI   R1, 0
        B    upa_have
upa_m1: LI   R2, 43
