t_rdc2: B    u_rdc
u_eolong: B  u_e_long
u_reol:
        LI   R2, 0
        STT  [R3], R2
        LI   R3, shbuf
        LDT  R1, [R3]
        LI   R2, 61
        TCMP R2, R1, R2
        B3   R2, u_scan, t_utend, u_scan
t_utend: B   u_tend
u_scan: LDT  R1, [R3]
        B3   R1, t_usdn, t_usdn, u_sch
t_usdn: B    u_sc_dn
u_sch:  LI   R2, 43
        TCMP R2, R1, R2
        B3   R2, u_s0, t_sadv, u_s0
t_sadv: B    u_sadv
u_s0:   LI   R2, 48
        TCMP R2, R1, R2
        B3   R2, u_s1, t_sadv2, u_s1
t_sadv2: B   u_sadv
u_s1:   LI   R2, 45
        TCMP R2, R1, R2
        B3   R2, t_ebch, t_sadv3, t_ebch
t_sadv3: B   u_sadv
t_ebch: B    u_e_badch
u_sadv: LI   R2, 1
        ADD  R3, R3, R2
        B    u_scan
u_sc_dn:
        LI   R1, shbuf
        NEG  R1, R1
        ADD  R1, R1, R3
        LI   R2, 18
        TCMP R2, R1, R2
        B3   R2, u_len6, t_uw, u_len6
t_uw:   B    u_word
u_len6: LI   R2, 6
        TCMP R2, R1, R2
        B3   R2, t_ellen, t_uck, t_ellen
t_uck:  B    u_clk
t_ellen: B   u_e_len
u_word:
