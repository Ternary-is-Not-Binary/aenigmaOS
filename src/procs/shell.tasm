u_done:
        LI   R1, st_tmp
        LDW  R1, [R1]
        SYS  22
        LI   R1, msg_snl
        SYS  10
        LI   R1, msg_lok
        SYS  10
        LI   R1, st_k
        LDW  R1, [R1]
        SYS  1
        LI   R1, msg_lok2
        SYS  10
        MOV  R1, R6
        SYS  1
        LI   R1, msg_snl
        SYS  10
