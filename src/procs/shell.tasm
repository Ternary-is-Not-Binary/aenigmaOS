        SYS  10
        B    sh_loop
shu_ok: LI   R2, st_tag
        STW  [R2], R1
        LI   R1, msg_lh
        SYS  10
        LI   R1, 9
        LI   R2, 123000
        SYS  20
        B3   R1, t_eroom, t_eroom, shu_tmp
t_eroom: B   u_e_room
shu_tmp:
        LI   R2, st_tmp
        STW  [R2], R1
        SYS  21
        LI   R2, st_tmpb
        STW  [R2], R1
        LI   R2, st_cur
        STW  [R2], R1
        LI   R2, st_k
        STW  [R2], R0
        LI   R2, st_ck
        STW  [R2], R0
        LI   R2, st_ckf
        STW  [R2], R0
u_rd:   LI   R3, shbuf
u_rdc:  SYS  2
        B3   R1, t_uneg, t_eeof, u_rg
