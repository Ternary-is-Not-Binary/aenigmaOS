u_pck:
        LI   R1, st_w
        LDW  R1, [R1]
        LI   R3, st_ck
        LDW  R3, [R3]
        TCMP R2, R1, R3
        B3   R2, t_eck, u_ckok, t_eck
t_eck:  B    u_e_ck
u_ckok:
        LI   R1, 1
        LI   R4, st_ckf
        STW  [R4], R1
        LI   R1, 10
        SYS  0
        B    u_rd
u_tend:
        LI   R1, st_ckf
        LDW  R1, [R1]
        B3   R1, t_enock, t_enock, u_alloc
t_enock: B   u_e_nock
u_alloc:
        LI   R2, st_k
        LDW  R2, [R2]
        LI   R1, 3
        MUL  R2, R2, R1
        LI   R1, 9
        ADD  R2, R2, R1
        LI   R1, st_tag
        LDW  R1, [R1]
        SYS  20
        B3   R1, t_erm2, t_erm2, u_objok
t_erm2: B    u_e_room
u_objok:
        MOV  R6, R1
        SYS  21
        LI   R2, 0
        STW  [R1], R2
        LI   R2, 3
        ADD  R1, R1, R2
        LI   R2, 0
        STW  [R1], R2
        LI   R2, 3
        ADD  R1, R1, R2
        LI   R2, 0
        STW  [R1], R2
        LI   R2, 3
        ADD  R1, R1, R2
        LI   R2, st_cur
        STW  [R2], R1
        LI   R2, st_i
        STW  [R2], R0
u_cp:   LI   R1, st_i
        LDW  R1, [R1]
        LI   R2, st_k
        LDW  R2, [R2]
        TCMP R2, R1, R2
        B3   R2, u_cpgo, t_cpd, t_cpd
t_cpd:  B    u_done
u_cpgo:
        LI   R3, st_tmpb
        LDW  R3, [R3]
        LDW  R1, [R3]
        LI   R2, 3
        ADD  R3, R3, R2
        LI   R4, st_tmpb
        STW  [R4], R3
        LI   R3, st_cur
        LDW  R3, [R3]
        STW  [R3], R1
        LI   R2, 3
        ADD  R3, R3, R2
        LI   R4, st_cur
        STW  [R4], R3
        LI   R1, st_i
        LDW  R1, [R1]
        LI   R2, 1
        ADD  R1, R1, R2
        LI   R4, st_i
        STW  [R4], R1
