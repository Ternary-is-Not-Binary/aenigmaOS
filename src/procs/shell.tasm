msg_sh0:  .tryte "aenigmaOS shell k10-PANEL - commands h l c u d r n a p t x\n\0"
msg_pr:   .tryte "> \0"
msg_cc:   .tryte "^C\n\0"
msg_hlp:  .tryte "h l: list  c: cat  u: upload  d: del  r: run  n: rename  a: asm  p: edit  t: panel  x: exit\n\0"
msg_bye:  .tryte "shell: exit\n\0"
msg_bad:  .tryte "? (h for help)\n\0"
msg_pt1:  .tryte "panel: text mode on (64x24)\n\0"
msg_pt0:  .tryte "panel: pixel mode\n\0"
msg_scf:  .tryte "panel: mode switch failed\n\0"
msg_noid: .tryte "no such object id\n\0"
msg_stb:  .tryte "store broken?!\n\0"
msg_snl:  .tryte "\n\0"
msg_ano:  .tryte "\na: need src id\n\0"
msg_azas: .tryte "\na: no zas object upload and name it zas\n\0"
msg_aroom: .tryte "\na: store full\n\0"
msg_aok:  .tryte "\na: ok \0"
msg_awid: .tryte " words id \0"
msg_aemp: .tryte "\na: zas made no words dump:\n\0"
msg_abad: .tryte "\na: zas output bad dump:\n\0"
msg_aovf: .tryte "\na: output over 41000 words\n\0"
msg_dno:  .tryte "usage: d <id>\n\0"
msg_dok:  .tryte "id gone: \0"
msg_uno:  .tryte "usage: u <tag>\n\0"
msg_lh:   .tryte "lenta: paste words then ck then ===\n\0"
msg_lroom: .tryte "lenta: store has no 123000t room - abort\n\0"
msg_llong: .tryte "\nlenta: line too long - abort\n\0"
msg_lbad: .tryte "\nlenta: bad char - want only + 0 -\n\0"
msg_llen: .tryte "\nlenta: line not 18-word and not 6-ck\n\0"
msg_lcap: .tryte "\nlenta: cap 41000 words - abort\n\0"
msg_leof: .tryte "\nlenta: EOF in tape - abort\n\0"
msg_lck:  .tryte "\nLENTA PORVALAS: ck mismatch - nothing created\n\0"
msg_lnock: .tryte "\nlenta: got === before ck - abort\n\0"
msg_lok:  .tryte "lenta sealed: \0"
msg_lok2: .tryte " words id \0"
